# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env in the project root. Never commit the .env itself -
# it is git-ignored, and it is where a real API key lives.
#
# Nothing here is required to start the app. With an empty .env the studio
# runs on deterministic mock providers: it writes placeholder images, plans a
# render, and every page works. Fill in a section when you want that part to
# be real.
# ─────────────────────────────────────────────────────────────────────────────

# ── ComfyUI: local image and video generation ────────────────────────────────
# "mock" writes deterministic placeholders and needs nothing installed.
# "real" submits graphs to a running ComfyUI instance.
COMFYUI_PROVIDER=mock
COMFYUI_URL=http://127.0.0.1:8000

# ── OpenAI: story authoring, hosted stills, narration ────────────────────────
# Without a key, story generation falls back to a deterministic local author,
# hosted stills are refused with an explanation, and narration uses the
# system voice. Everything below is optional and has a working default.
OPENAI_API_KEY=
# Text model for briefs, scenes, shots and prompts. Blank asks the provider
# for its default; "gpt-4.1" is what this project was built against.
OPENAI_MODEL=
# Image model and quality tier for paid stills. Default: gpt-image-1-mini, medium.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
# Only for an Azure/proxy/compatible endpoint. Default: https://api.openai.com/v1
OPENAI_BASE_URL=
# Only if your key belongs to more than one organization.
OPENAI_ORG_ID=
# Pin one text provider for the whole machine, ignoring the usual rule of
# "OpenAI when a key is set, otherwise the deterministic mock". A pinned
# provider that turns out to be unconfigured fails loudly rather than
# quietly writing placeholder text into your storyboard.
CAS_AI_PROVIDER=
# Overrides the built-in price table used to estimate what a run will cost,
# in USD per image, if OpenAI's pricing has moved since this was written.
CAS_OPENAI_IMAGE_PRICE_USD=

# ── Storage ──────────────────────────────────────────────────────────────────
# Database, imported workflows, generated media and exports. Defaults to
# backend/data. A relative path resolves against the directory you start the
# server from, so prefer an absolute one. Spaces and non-ASCII are supported.
CAS_DATA_DIR=

# ── Development switches ─────────────────────────────────────────────────────
# Run the API without its background generation worker.
CAS_DISABLE_QUEUE=
# How long a mock job pretends to be queued and running, in seconds.
# Lower both to make the end-to-end scripts finish quickly.
CAS_MOCK_QUEUED_SEC=1.0
CAS_MOCK_RUNNING_SEC=2.0
# Ignore the .env file entirely. The test suite sets this so a developer's
# real key can never reach a test.
CAS_DISABLE_DOTENV=
